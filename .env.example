DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"
BETTER_AUTH_SECRET="generate-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3001"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Code widget — AI-assisted mode. Routed through Vercel AI Gateway, so no
# per-provider key is needed. Unset disables generation only; manual mode still runs.
AI_GATEWAY_API_KEY=""

# Code widget — execution sandbox (Judge0). Self-hosted; see docker/judge0/ for
# the compose file to run on the box. With JUDGE0_URL unset, running code reports
# "not configured" and every other part of the app works normally.
#
# SECURITY: an internet-reachable Judge0 with no AUTHN_TOKEN is an open arbitrary
# code execution service for anyone who finds the URL. Set AUTHN_TOKEN in
# judge0.conf and the same value as JUDGE0_KEY here.
#
# JUDGE0_HOST is ONLY for Judge0 CE on RapidAPI — its presence switches auth to
# the RapidAPI headers. Leave it empty for a self-hosted instance.
JUDGE0_URL="https://judge0.your-domain.com"
JUDGE0_KEY=""
JUDGE0_HOST=""

# Email (invitations + notification emails) — sent through Resend from the
# verified helmworkspace.me domain. The Vercel Resend integration sets
# RESEND_API_KEY in the project; copy it here for local dev. Unset = emails are
# logged instead of sent and queued notification emails wait in email_outbox.
RESEND_API_KEY=""
EMAIL_FROM="Helm <notifications@helmworkspace.me>"

# Vercel Cron bearer secret. Required in production for /api/cron/email-outbox
# (it refuses to run without it); Vercel sends it automatically once set.
CRON_SECRET=""
